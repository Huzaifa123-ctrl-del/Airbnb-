<%-include('../parsials/head.ejs')%>

    <body>
        <header>
            <h1>Login With your Homes Info</h1>
        </header>

        <main class="form-wrapper">
            <div class="form-card">
                <div class="card-icon">🏠</div>
                <h1>Login</h1>

                <% if (typeof error !=='undefined' && error) { %>
                    <div id="myModal"
                        style="position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); display:flex; justify-content:center; align-items:center; z-index:9999;">
                        <div
                            style="background:white; padding:30px; border-radius:12px; text-align:center; width:300px;">
                            <h3 style="color:red;">Error</h3>
                            <p>
                                <%= error %>
                            </p>
                            <button onclick="document.getElementById('myModal').style.display='none'"
                                style="margin-top:15px; padding:8px 20px; background:#ff385c; color:white; border:none; border-radius:8px;cursor: pointer;">OK</button>
                        </div>
                    </div>
                    <% } %>
                        <form action="" method="POST">
                            <label>House Name</label>
                            <input type="text" placeholder="Email" name="email" required>
                            <input type="password" name="password" placeholder="password" required>
                            <button type="submit" class="btn-submit">Submit</button>
                        </form>

            </div>
        </main>
    </body>

    </html>
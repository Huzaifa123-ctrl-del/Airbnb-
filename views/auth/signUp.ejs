<%- include('../parsials/head.ejs') %>
    <link rel="stylesheet" href="style.css">

    <body>
        <header class="main-header">
            <h1 class="logo">Airbnb Clone</h1>
            <nav>
                <a href="/">Home</a>
                <a href="/auth/login">Login</a>
            </nav>
        </header>

        <main class="form-wrapper">
            <div class="form-card">
                <div class="card-icon">🏠</div>
                <h1 class="form-title">Create Account</h1>
                <p class="form-subtitle">Register as a User</p>

                <% if (typeof error !=='undefined' && error) { %>
                    <div id="myModal"
                        style="position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); display:flex; justify-content:center; align-items:center; z-index:9999;">
                        <div
                            style="background:white; padding:30px; border-radius:12px; text-align:center; width:300px; box-shadow:0 5px 15px rgba(0,0,0,0.3);">
                            <h3 style="color:red; margin-bottom:10px;">Error</h3>
                            <p>
                                <%= error %>
                            </p>
                            <button onclick="document.getElementById('myModal').style.display='none'"
                                style="margin-top:15px; padding:8px 20px; background:#ff385c; color:white; border:none; border-radius:8px; cursor:pointer;">OK</button>
                        </div>
                    </div>
                    <% } %>

                        <form action="/auth/signup" method="POST" class="signup-form">
                            <div class="input-group">
                                <input type="text" class="form-input" placeholder="First Name" name="firstName"
                                    required>
                            </div>
                            <div class="input-group">
                                <input type="text" class="form-input" placeholder="Last Name" name="lastName">
                            </div>
                            <div class="input-group">
                                <input type="email" class="form-input" placeholder="Email Address" name="email"
                                    required>
                            </div>
                            <div class="input-group">
                                <input type="password" class="form-input" name="password" placeholder="Password"
                                    required>
                            </div>
                            <div class="input-group">
                                <input type="password" class="form-input" name="cpassword"
                                    placeholder="Confirm Password" required>
                            </div>

                            <div class="radio-group">
                                <label class="radio-label"><input type="radio" name="userType" value="Guest"
                                        checked><span> Guest</span></label>
                                <label class="radio-label"><input type="radio" name="userType" value="host"><span>
                                        Host</span></label>
                            </div>

                            <button type="submit" class="btn-submit">Sign Up</button>

                            <p class="login-link">Already have an account? <a href="/auth/login">Login</a></p>
                        </form>
            </div>
        </main>
    </body>

    </html>
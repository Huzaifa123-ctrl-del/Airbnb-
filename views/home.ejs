<%-include('parsials/head.ejs')%>

  <body>
    <%-include('parsials/header.ejs')%>

      <style>
        .container {
          max-width: 1120px;
          margin: 0 auto;
          padding: 0 20px 40px 20px;
        }

        .page-header {
          background: white;
          border: 1px solid #eaeaea;
          border-radius: 20px;
          padding: 22px 28px;
          display: flex;
          justify-content: space-between;
          align-items: center;
          margin: 28px 0;
          box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
        }

        .page-header h1 {
          margin: 0;
          font-size: 22px;
          font-weight: 800;
          color: #111;
          letter-spacing: -0.5px;
        }

        .btn-add {
          background: #ff385c;
          color: white !important;
          padding: 10px 18px;
          border: none;
          border-radius: 100px;
          text-decoration: none;
          font-size: 13px;
          font-weight: 800;
          box-shadow: 0 4px 10px rgba(255, 56, 92, 0.3);
          transition: 0.2s;
        }

        .btn-add:hover {
          transform: scale(1.05);
          background: #e31c5f;
        }

        .grid {
          display: grid;
          grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
          gap: 22px;
        }

        .card {
          background: white;
          border: 1px solid #eeeeee;
          border-radius: 20px;
          padding: 22px;
          box-shadow: 0 6px 16px rgba(0, 0, 0, 0.04);
          transition: all 0.25s ease;
          position: relative;
          overflow: hidden;
        }

        .card:hover {
          transform: translateY(-6px);
          box-shadow: 0 16px 30px rgba(0, 0, 0, 0.09);
          border-color: #e5e5e5;
        }

        .card-icon {
          width: 285px;
          height: 203px;
          background: #fff1f2;
          border-radius: 14px;
          display: flex;
          align-items: center;
          justify-content: center;
          font-size: 28px;
        }

        .card-icon img {
          height: 100%;
          width: 100%;
          border-radius: 1rem;
        }

        .card h3 {
          margin: 14px 0 4px 0;
          font-size: 16.5px;
          font-weight: 700;
          color: #111;
        }

        .card p {
          margin: 0;
          color: #717171;
          font-size: 14px;
          font-weight: 500;
        }

        .btn-details {
          display: block;
          margin-top: 18px;
          background: #1a1a1a;
          color: white;
          text-align: center;
          padding: 12px;
          border-radius: 12px;
          text-decoration: none;
          font-size: 13.5px;
          font-weight: 600;
          transition: 0.2s;
        }

        .btn-details:hover {
          background: black;
        }
      </style>

      <main class="container">
        <div class="page-header">
          <h1>Here are Our register Home</h1>
          <% if(isLoggedIn) {%>
            <a href="/host/add-home" class="btn-add">+ Add Home</a>
            <%}%>
        </div>

        <div class="grid">
          <% registerHome.forEach(home=>{ %>
            <div class="card">
              <div class="card-icon">
                <img src="/uploads/<%= home.file %>">
              </div>
              <h3>
                <%=home.houseName%>
              </h3>
              <p>$12324 / night</p>
              <a href="/homes/<%= home.id%>" class="btn-details">Home Details</a>
            </div>
            <% })%>
        </div>
      </main>
  </body>

  </html>